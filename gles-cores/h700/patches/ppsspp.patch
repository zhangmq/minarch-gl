 #include <mutex>
 
 #include "Common/Log.h"
@@ -23,6 +24,13 @@ class IndependentTask : public Task {
 	TaskPriority prio_;
 };
 
+// GCC 8.3 does not deduce class template arguments for `new`; this helper
+// keeps move-only lambdas working without spelling their type.
+template<class T>
+IndependentTask<T> *MakeIndependentTask(TaskType type, TaskPriority prio, T &&func) {
+	return new IndependentTask<T>(type, prio, std::forward<T>(func));
+}
